# Copie para .env (ignorado pelo git). Valores compatíveis com o docker-compose.yml.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tcc_bruto
DATABASE_URL=postgres://tcc:tcc@localhost:5432/tcc?sslmode=disable

# Ingestor MQTT (só usado com: docker compose --profile mqtt up)
# TTN: broker TLS da região da sua aplicação; usuário = application_id; senha = chave de API.
MQTT_BROKER=tls://eu1.cloud.thethings.network:8883
MQTT_USUARIO=
MQTT_SENHA=
MQTT_TOPICO=v3/+/devices/+/up
MQTT_CLIENT_ID=tcc-ingestor
MQTT_QOS=1

# Ingestor MQTT do sensor de deslizamento (só usado com:
# docker compose --profile sensor_deslizamento up).
# Broker do ChirpStack v4. Tópico default do formato v4.
# Em deployment local sem TLS, use algo como: tcp://chirpstack:1883
SD_MQTT_BROKER=
SD_MQTT_USUARIO=
SD_MQTT_SENHA=
SD_MQTT_TOPICO=application/+/device/+/event/up
SD_MQTT_CLIENT_ID=tcc-sensor-deslizamento
SD_MQTT_QOS=1

# Worker de processamento
WORKERS=2
MAX_TENTATIVAS=5
RESERVA_SEGUNDOS=60
INTERVALO_MS=500
AUTO_CADASTRAR_SENSOR=true

# API
API_ADDR=:8080
